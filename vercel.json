{
  "buildCommand": "bash build.sh",
  "outputDirectory": ".",
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*\\.(js|css|png|jpg|ico|svg|json|webmanifest|woff2?))", "dest": "/$1" },
    { "src": "/reference.html", "dest": "/reference.html" },
    { "src": "/admin.html", "dest": "/admin.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
